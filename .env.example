# Copy to server/.env and fill in. The .env file never goes into the repo.

# Token the tablet sends on every connection. Generate it with: openssl rand -hex 24
PINO_TOKEN=

# Where the server keeps its database and audio (outside the repo)
PINO_DATA=~/.pino
PINO_HOST=0.0.0.0
PINO_PORT=4390
PINO_TZ=Europe/Rome
# Language of the server's own words on screen and in voice (it | en). Claude answers in the speaker's language.
PINO_LANG=it

# The brain: Claude Code with YOUR subscription login (`claude` → /login, once).
# Do NOT set ANTHROPIC_API_KEY: if it is there, the CLI bills the key instead of the subscription.
# Haiku with low effort answers first; for hard questions claude-sonnet-5-5 or claude-opus-5-5.
PINO_MODEL=claude-haiku-5-5
PINO_EFFORT=low
# The connectors Pino keeps (names as in `claude mcp list`); every other MCP server is switched off for it.
PINO_CONNECTORS=WhatsApp,Gmail,Google Calendar,Google Drive
# After this many quiet minutes the conversation starts afresh (shorter context, faster answers)
PINO_IDLE_RESET_MIN=10
# If nothing has been said after this many seconds, Pino says «un attimo» (0 = never)
PINO_FILLER_S=3

# Understanding and speaking: openai | elevenlabs (they can be mixed)
PINO_STT=openai
PINO_TTS=openai
OPENAI_API_KEY=
PINO_OPENAI_STT_MODEL=gpt-4o-transcribe
PINO_OPENAI_TTS_MODEL=gpt-4o-mini-tts
PINO_OPENAI_VOICE=ash

ELEVENLABS_API_KEY=
PINO_ELEVENLABS_VOICE_ID=
PINO_ELEVENLABS_STT_MODEL=scribe_v1
PINO_ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Audio is deleted after this many days; the transcribed text stays
PINO_AUDIO_DAYS=30
# A2UI version spoken with the tablet (the official Android renderer reads v0.9.1)
PINO_A2UI_VERSION=v0.9.1
# How long a confirmation waits before it counts as a no (seconds)
PINO_CONFIRM_TIMEOUT_S=120
